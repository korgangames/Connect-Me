<Window x:Class="ConnectMe.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Me — Birleşik Cihaz Kontrolü &amp; Ortak Cep (Korgan Games)"
        Width="1120" Height="760"
        MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="155"/>
        </Grid.RowDefinitions>

        <!-- ÜST DURUM BARI -->
        <Border Grid.Row="0"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌐 Connect Me" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,12,0"/>
                        <Border x:Name="ActiveFocusBadge" Background="#1E3A2F" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="10,3">
                            <TextBlock x:Name="ActiveFocusText" Text="🪟 Aktif Kontrol: Windows (Yerel)" FontWeight="SemiBold" Foreground="#4ADE80" FontSize="12.5"/>
                        </Border>
                        <Border x:Name="LockStateBadge" Background="#1F2937" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="8,0,0,0">
                            <TextBlock x:Name="LockStateText" Text="🔓 Kenar Geçişi: Açık (ScrollLock / Ctrl+Alt+L)" Foreground="#9CA3AF" FontSize="12"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="LocalNetworkInfoText"
                               Text="Yerel IP: Yükleniyor... | Girdi Portu: 42850 (UDP) | Veri Portu: 42851 (TCP)"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#1F2937" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="12,0">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="EŞLEŞME PIN KODU" FontSize="10" Foreground="#8B949E" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PinCodeText" Text="------" FontSize="17" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="2"
                        x:Name="ToggleLockButton"
                        Click="ToggleLockButton_Click"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="14,8"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Content="🔒 Ekranı Kilitle / Aç"/>
            </Grid>
        </Border>

        <!-- ORTA ANA BÖLÜM: SOL (UZAMSAL HARİTA & CİHAZLAR) + SAĞ (MANYETİK CEP & PANO) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL PANEL: UZAMSAL EKRAN HARİTASI & CİHAZ BAĞLANTISI -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="195"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="🖥️ Uzamsal Ekran Dizilimi (Android Cihazın Hangi Kenarda?)"
                               FontSize="14.5"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <!-- GÖRSEL EKRAN KENAR SEÇİCİSİ -->
                    <Border Grid.Row="1"
                            Background="#0D1117"
                            BorderBrush="#21262D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="115"/>
                            </Grid.ColumnDefinitions>

                            <!-- ÜST KENAR -->
                            <Button x:Name="EdgeTopBtn" Grid.Row="0" Grid.Column="1"
                                    Click="EdgeTopBtn_Click"
                                    Margin="16,0" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Cursor="Hand"
                                    Content="⬆️ ÜST KENAR (Android Üstte)"/>

                            <!-- SOL KENAR -->
                            <Button x:Name="EdgeLeftBtn" Grid.Row="1" Grid.Column="0"
                                    Click="EdgeLeftBtn_Click"
                                    Margin="0,8" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Cursor="Hand"
                                    Content="⬅️ SOL KENAR&#x0a;(Android Solda)"/>

                            <!-- MERKEZ WINDOWS EKRANI -->
                            <Border Grid.Row="1" Grid.Column="1"
                                    Background="#172554"
                                    BorderBrush="#38BDF8"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Margin="12,6">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🪟 WINDOWS ANA EKRAN" FontWeight="Bold" FontSize="13" Foreground="#93C5FD" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MonitorResolutionText" Text="1920 x 1080" FontSize="11.5" Foreground="#BFDBFE" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="AssignedEdgeSummaryText" Text="Aktif Geçiş Kenarı: SAĞ ➡️" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- SAĞ KENAR -->
                            <Button x:Name="EdgeRightBtn" Grid.Row="1" Grid.Column="2"
                                    Click="EdgeRightBtn_Click"
                                    Margin="0,8" Background="#0369A1" Foreground="White" BorderBrush="#38BDF8" Cursor="Hand"
                                    Content="SAĞ KENAR ➡️&#x0a;(Android Sağda)"/>

                            <!-- ALT KENAR -->
                            <Button x:Name="EdgeBottomBtn" Grid.Row="2" Grid.Column="1"
                                    Click="EdgeBottomBtn_Click"
                                    Margin="16,0" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Cursor="Hand"
                                    Content="⬇️ ALT KENAR (Android Altta)"/>
                        </Grid>
                    </Border>

                    <!-- CİHAZ LİSTESİ BAŞLIĞI VE YENİLEME -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,6">
                        <TextBlock Text="📱 Bağlı / Keşfedilen Cihazlar (Wi-Fi + BLE)" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ScanDevicesBtn"
                                    Click="ScanDevicesBtn_Click"
                                    Background="#1F2937" Foreground="#38BDF8" BorderBrush="#30363D" Padding="8,4" Margin="0,0,6,0" Cursor="Hand"
                                    Content="📡 Şimdi Tara"/>
                            <Button x:Name="TestSwitchBtn"
                                    Click="TestSwitchBtn_Click"
                                    Background="#059669" Foreground="White" BorderThickness="0" Padding="10,4" Cursor="Hand"
                                    Content="🚀 Şimdi Android'e Geç (Test)"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- CİHAZ LİSTESİ -->
                    <ListBox x:Name="PeersListBox"
                             Grid.Row="3"
                             Background="#0D1117"
                             BorderBrush="#21262D"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             SelectionChanged="PeersListBox_SelectionChanged"
                             Margin="0,0,0,10"/>

                    <!-- MANUEL IP EKLEME & KENAR DİRENCİ -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ManualIpTextBox"
                                 Grid.Column="0"
                                 Background="#0D1117"
                                 Foreground="White"
                                 BorderBrush="#30363D"
                                 Padding="8,6"
                                 VerticalContentAlignment="Center"
                                 Text="192.168.1."
                                 ToolTip="Android cihazın yerel Wi-Fi IP adresini girin"/>
                        <Button x:Name="AddManualPeerBtn"
                                Grid.Column="1"
                                Click="AddManualPeerBtn_Click"
                                Background="#2563EB" Foreground="White" BorderThickness="0" Padding="12,6" Margin="8,0,0,0" Cursor="Hand"
                                Content="➕ Android IP Bağla"/>
                        <Button x:Name="AddLoopbackSimBtn"
                                Grid.Column="2"
                                Click="AddLoopbackSimBtn_Click"
                                Background="#374151" Foreground="#E5E7EB" BorderThickness="0" Padding="10,6" Margin="6,0,0,0" Cursor="Hand"
                                ToolTip="Telefon olmadan kenar geçişini yerel bilgisayarda test etmek için sanal hedef ekler"
                                Content="🧪 Simülatör Ekle"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- SAĞ PANEL: MANYETİK ORTAK CEP (DROP SHELF) & EVRENSEL PANO -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="130"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="🧲 Manyetik Ortak Cep (Drop Shelf) &amp; Eşya Paylaşımı"
                               FontSize="14.5"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <!-- SÜRÜKLE BIRAK ALANI -->
                    <Border x:Name="DropZoneBorder"
                            Grid.Row="1"
                            Background="#0D1117"
                            BorderBrush="#38BDF8"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Margin="0,0,0,12"
                            AllowDrop="True"
                            Drop="Window_Drop"
                            DragOver="Window_DragOver">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📂 Dosya, Fotoğraf veya Eşyayı Buraya Sürükleyip Bırakın"
                                       FontWeight="Bold" FontSize="13.5" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                            <TextBlock Text="Bırakılan dosyalar Wi-Fi üzerinden anında Android cihazınıza gönderilir"
                                       FontSize="11.5" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="PickFileToSendBtn"
                                        Click="PickFileToSendBtn_Click"
                                        Background="#0284C7" Foreground="White" BorderThickness="0" Padding="12,5" Margin="0,0,8,0" Cursor="Hand"
                                        Content="📤 Dosya Seç ve Gönder"/>
                                <Button x:Name="OpenShelfFolderBtn"
                                        Click="OpenShelfFolderBtn_Click"
                                        Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="12,5" Cursor="Hand"
                                        Content="📁 İndirilen Cep Klasörünü Aç"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CEPTEKİ EŞYALAR LİSTESİ -->
                    <TextBlock Grid.Row="2"
                               Text="📦 Ortak Cepteki Son Paylaşılan Eşyalar:"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,0,6"/>

                    <ListBox x:Name="ShelfItemsListBox"
                             Grid.Row="3"
                             Background="#0D1117"
                             BorderBrush="#21262D"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             MouseDoubleClick="ShelfItemsListBox_MouseDoubleClick"
                             Margin="0,0,0,12"/>

                    <!-- EVRENSEL PANO KONTROLLERİ -->
                    <Border Grid.Row="4"
                            Background="#0D1117"
                            BorderBrush="#21262D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <DockPanel>
                            <CheckBox x:Name="AutoClipboardCheckBox"
                                      IsChecked="True"
                                      Checked="AutoClipboardCheckBox_Changed"
                                      Unchecked="AutoClipboardCheckBox_Changed"
                                      Foreground="White"
                                      VerticalAlignment="Center"
                                      Content="📋 Evrensel Pano Otomatik Senkronizasyon (Metin &amp; Görsel)"/>
                            <Button x:Name="PushClipboardNowBtn"
                                    Click="PushClipboardNowBtn_Click"
                                    HorizontalAlignment="Right"
                                    Background="#1F2937" Foreground="#38BDF8" BorderBrush="#30363D" Padding="10,4" Cursor="Hand"
                                    Content="⚡ Panoyu Şimdi Gönder"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ALT PANEL: CANLI SİSTEM & AĞ GÜNLÜĞÜ -->
        <Border Grid.Row="2"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="📡 Canlı Bağlantı, Kenar Geçişi ve Girdi Telemetrisi" FontWeight="SemiBold" FontSize="12.5" Foreground="#9CA3AF"/>
                    <TextBlock Text="İpucu: Android'deyken 'Scroll Lock' veya 'Ctrl+Alt+L' tuşuyla imleci anında Windows'a geri çağırabilirsiniz."
                               FontSize="11.5" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                </DockPanel>
                <ListBox x:Name="TelemetryLogListBox"
                         Grid.Row="1"
                         Background="#0D1117"
                         BorderBrush="#21262D"
                         Foreground="#A7F3D0"
                         FontFamily="Consolas"
                         FontSize="11.5"/>
            </Grid>
        </Border>
    </Grid>
</Window>
