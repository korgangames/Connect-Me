<Window x:Class="ConnectMe.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Me — Çoklu Cihaz Ekran Konfigürasyonu, Çift Taraflı PIN &amp; Ortak Cep (Korgan Games)"
        Width="1260" Height="820"
        MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <!-- ÜST DURUM & ÇİFT TARAFLI 6 HANELİ PIN BAR -->
        <Border Grid.Row="0"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌐 Connect Me" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,12,0"/>
                        <Border x:Name="ActiveFocusBadge" Background="#1E3A2F" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="10,3">
                            <TextBlock x:Name="ActiveFocusText" Text="🪟 Aktif Kontrol: Bu Bilgisayar (Yerel)" FontWeight="SemiBold" Foreground="#4ADE80" FontSize="12.5"/>
                        </Border>
                        <Border x:Name="LockStateBadge" Background="#1F2937" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="8,0,0,0">
                            <TextBlock x:Name="LockStateText" Text="🔓 Kenar Geçişi: Açık (ScrollLock / Ctrl+Alt+L)" Foreground="#9CA3AF" FontSize="12"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="LocalNetworkInfoText"
                               Text="Yerel IP: Yükleniyor... | Girdi Portu: 42850 (UDP) | Veri &amp; PIN Portu: 42851 (TCP)"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11.5"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- BU CİHAZIN 6 HANELİ KODU -->
                <Border Grid.Column="1" Background="#0D1117" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="8" Padding="14,6" Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                            <TextBlock Text="BU CİHAZIN 6 HANELİ KODU (KARŞI CİHAZA GİRİN)" FontSize="9.5" FontWeight="SemiBold" Foreground="#93C5FD"/>
                            <TextBlock x:Name="PinCodeText" Text="------" FontSize="19" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="RegeneratePinBtn"
                                Click="RegeneratePinBtn_Click"
                                Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="8,4" Cursor="Hand"
                                ToolTip="Yeni 6 haneli güvenlik kodu üret"
                                Content="🔄"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="2"
                        x:Name="ToggleLockButton"
                        Click="ToggleLockButton_Click"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="14,8"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Content="🔒 Ekranı Kilitle / Aç"/>
            </Grid>
        </Border>

        <!-- ORTA ANA BÖLÜM: 3 SÜTUN (1: CİHAZLAR & ÇİFT TARAFLI PIN, 2: 2D EKRAN KONFİGÜRASYON KANVASI, 3: ORTAK CEP & PANO) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL PANEL: CİHAZ LİSTESİ & ÇİFT TARAFLI 6 HANELİ KOD EŞLEŞTİRME -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="📡 Cihazlar &amp; Çift Taraflı Eşleşme" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ScanDevicesBtn"
                                    Click="ScanDevicesBtn_Click"
                                    Background="#1F2937" Foreground="#38BDF8" BorderBrush="#30363D" Padding="8,4" Margin="0,0,6,0" Cursor="Hand"
                                    Content="🔍 Ağda Tara"/>
                            <Button x:Name="AddMultiSimBtn"
                                    Click="AddMultiSimBtn_Click"
                                    Background="#374151" Foreground="#F0F6FC" BorderThickness="0" Padding="8,4" Cursor="Hand"
                                    ToolTip="Çoklu cihaz (Android Telefon, Tablet, Nobara Linux, 2. PC) simülasyonu ekler"
                                    Content="🧪 +Cihaz Simüle Et"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- KEŞFEDİLEN VE BAĞLI CİHAZLAR LİSTESİ -->
                    <ListBox x:Name="PeersListBox"
                             Grid.Row="1"
                             Background="#0D1117"
                             BorderBrush="#21262D"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             SelectionChanged="PeersListBox_SelectionChanged"
                             Margin="0,0,0,10"/>

                    <!-- ÇİFT TARAFLI 6 HANELİ PIN ONAY PANELİ -->
                    <Border Grid.Row="2"
                            Background="#0D1117"
                            BorderBrush="#1E3A8A"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="SelectedPeerTitleText"
                                       Text="🔐 Seçili Cihaz ile Çift Taraflı 6 Haneli Kod Onayı"
                                       FontWeight="Bold" FontSize="12.5" Foreground="#60A5FA"/>
                            <TextBlock x:Name="SelectedPeerStatusText"
                                       Text="Listeden bir cihaz seçin ve o cihazın ekranındaki 6 haneli kodu aşağıya girin."
                                       FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,3,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RemotePinInputBox"
                                         Grid.Column="0"
                                         MaxLength="6"
                                         Background="#161B22"
                                         Foreground="#38BDF8"
                                         BorderBrush="#30363D"
                                         FontSize="15"
                                         FontWeight="Bold"
                                         Padding="8,5"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Karşı cihazın ekranında yazan 6 haneli kodu buraya girin"/>
                                <Button x:Name="VerifyRemotePinBtn"
                                        Grid.Column="1"
                                        Click="VerifyRemotePinBtn_Click"
                                        Background="#059669" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="12,6" Margin="6,0,0,0" Cursor="Hand"
                                        Content="✅ Kodu Doğrula"/>
                            </Grid>

                            <!-- SİMÜLATÖR CİHAZLARI İÇİN KARŞI TARAFTAN BİZİM KODUMUZU ONAYLAMA TEST BUTONU -->
                            <Button x:Name="SimConfirmOurPinBtn"
                                    Click="SimConfirmOurPinBtn_Click"
                                    Visibility="Collapsed"
                                    Background="#1D4ED8" Foreground="White" BorderThickness="0" Padding="8,5" Margin="0,7,0,0" Cursor="Hand"
                                    Content="📲 [Simülatör] Karşı Cihazda Da Benim Kodumu Onayla"/>
                        </StackPanel>
                    </Border>

                    <!-- MANUEL IP İLE CİHAZ EKLEME -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ManualIpTextBox"
                                 Grid.Column="0"
                                 Background="#0D1117"
                                 Foreground="White"
                                 BorderBrush="#30363D"
                                 Padding="8,5"
                                 VerticalContentAlignment="Center"
                                 Text="192.168.1."
                                 ToolTip="Bağlanmak istediğiniz PC veya Android cihazın IP adresi"/>
                        <Button x:Name="AddManualPeerBtn"
                                Grid.Column="1"
                                Click="AddManualPeerBtn_Click"
                                Background="#2563EB" Foreground="White" BorderThickness="0" Padding="10,5" Margin="6,0,0,0" Cursor="Hand"
                                Content="➕ IP ile Cihaz Bul"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ORTA PANEL: 2D EKRAN KONFİGÜRASYONU KANVASI (WINDOWS DISPLAY SETTINGS TARZI) -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="🖥️ Ekran Konfigürasyonu (Sürükle &amp; Kenarlara Yapıştır)"
                                   FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="AutoArrangeScreensBtn"
                                    Click="AutoArrangeScreensBtn_Click"
                                    Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="9,4" Margin="0,0,6,0" Cursor="Hand"
                                    Content="📐 Otomatik Hizala"/>
                            <Button x:Name="TestSwitchBtn"
                                    Click="TestSwitchBtn_Click"
                                    Background="#0284C7" Foreground="White" BorderThickness="0" Padding="10,4" Cursor="Hand"
                                    Content="🚀 Seçili Ekrana Geç"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Grid.Row="1"
                               Text="Çift taraflı PIN onayı tamamlanan tüm PC ve Android ekranlarını fareyle sürükleyip merkez ekranın istediğiniz kenarına (veya kenar kesitine) yerleştirin. Mavi çizgiler aktif geçiş portallarını gösterir."
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <!-- 2D SÜRÜKLE-BIRAK EKRAN DİZİLİM KANVASI -->
                    <Border Grid.Row="2"
                            Background="#090D13"
                            BorderBrush="#21262D"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Canvas x:Name="DisplayArrangementCanvas"
                                SizeChanged="DisplayArrangementCanvas_SizeChanged"
                                Background="Transparent"/>
                    </Border>

                    <!-- SEÇİLİ CİHAZ HIZLI KENAR ATAMA VE BİLGİ ÇUBUĞU -->
                    <DockPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock x:Name="CanvasSelectionInfoText"
                                   Text="İpucu: Bir kenara birden fazla cihaz (örn. sağ üste Laptop, sağ alta Android) koyabilirsiniz."
                                   FontSize="11.5"
                                   Foreground="#38BDF8"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="⬅️ Sol" Click="QuickAssignLeft_Click" Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="8,3" Margin="2,0" Cursor="Hand"/>
                            <Button Content="⬆️ Üst" Click="QuickAssignTop_Click" Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="8,3" Margin="2,0" Cursor="Hand"/>
                            <Button Content="⬇️ Alt" Click="QuickAssignBottom_Click" Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="8,3" Margin="2,0" Cursor="Hand"/>
                            <Button Content="Sağ ➡️" Click="QuickAssignRight_Click" Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="8,3" Margin="2,0" Cursor="Hand"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- SAĞ PANEL: MANYETİK ORTAK CEP (DROP SHELF) & EVRENSEL PANO -->
            <Border Grid.Column="4"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="125"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="🧲 Ortak Cep (Drop Shelf) &amp; Pano"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <!-- SÜRÜKLE BIRAK ALANI -->
                    <Border x:Name="DropZoneBorder"
                            Grid.Row="1"
                            Background="#0D1117"
                            BorderBrush="#38BDF8"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Margin="0,0,0,10"
                            AllowDrop="True"
                            Drop="Window_Drop"
                            DragOver="Window_DragOver">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8">
                            <TextBlock Text="📂 Eşyayı Sürükleyip Bırakın"
                                       FontWeight="Bold" FontSize="13" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                            <TextBlock Text="Seçili cihaza veya tüm onaylı cihazlara anında gönderilir"
                                       FontSize="10.5" Foreground="#8B949E" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="PickFileToSendBtn"
                                        Click="PickFileToSendBtn_Click"
                                        Background="#0284C7" Foreground="White" BorderThickness="0" Padding="10,4" Margin="0,0,6,0" Cursor="Hand"
                                        Content="📤 Dosya Gönder"/>
                                <Button x:Name="OpenShelfFolderBtn"
                                        Click="OpenShelfFolderBtn_Click"
                                        Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="10,4" Cursor="Hand"
                                        Content="📁 Klasörü Aç"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Text="📦 Ortak Cepteki Eşyalar:"
                               FontWeight="SemiBold"
                               FontSize="12.5"
                               Margin="0,0,0,6"/>

                    <ListBox x:Name="ShelfItemsListBox"
                             Grid.Row="3"
                             Background="#0D1117"
                             BorderBrush="#21262D"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             MouseDoubleClick="ShelfItemsListBox_MouseDoubleClick"
                             Margin="0,0,0,10"/>

                    <!-- EVRENSEL PANO KONTROLLERİ -->
                    <Border Grid.Row="4"
                            Background="#0D1117"
                            BorderBrush="#21262D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <StackPanel>
                            <CheckBox x:Name="AutoClipboardCheckBox"
                                      IsChecked="True"
                                      Checked="AutoClipboardCheckBox_Changed"
                                      Unchecked="AutoClipboardCheckBox_Changed"
                                      Foreground="White"
                                      Content="📋 Otomatik Pano Senkronizasyonu"/>
                            <Button x:Name="PushClipboardNowBtn"
                                    Click="PushClipboardNowBtn_Click"
                                    Margin="0,6,0,0"
                                    Background="#1F2937" Foreground="#38BDF8" BorderBrush="#30363D" Padding="8,4" Cursor="Hand"
                                    Content="⚡ Panoyu Tüm Onaylı Cihazlara Gönder"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ALT PANEL: CANLI SİSTEM & AĞ GÜNLÜĞÜ -->
        <Border Grid.Row="2"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="📡 Canlı Çoklu Cihaz, PIN Doğrulama ve Kenar Geçiş Telemetrisi" FontWeight="SemiBold" FontSize="12" Foreground="#9CA3AF"/>
                    <TextBlock Text="İpucu: Diğer cihazdayken 'Scroll Lock' veya 'Ctrl+Alt+L' ile imleci anında ana ekrana geri çağırabilirsiniz."
                               FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                </DockPanel>
                <ListBox x:Name="TelemetryLogListBox"
                         Grid.Row="1"
                         Background="#0D1117"
                         BorderBrush="#21262D"
                         Foreground="#A7F3D0"
                         FontFamily="Consolas"
                         FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
