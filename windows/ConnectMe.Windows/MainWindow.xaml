<Window x:Class="ConnectMe.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Me — Çoklu Cihaz Ekran Konfigürasyonu, Çift Taraflı PIN &amp; Ortak Cep (Korgan Games)"
        Width="1180" Height="740"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#30363D"
                                BorderThickness="1,1,1,0"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}"
                                Cursor="Hand">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E3A8A"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#F0F6FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ÜST KOMPAKT DURUM & 6 HANELİ PIN ÇUBUĞU -->
        <Border Grid.Row="0"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="🌐 Connect Me" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border x:Name="ActiveFocusBadge" Background="#1E3A2F" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,2,8,2">
                        <TextBlock x:Name="ActiveFocusText" Text="🪟 Kontrol: Bu Bilgisayar (Yerel)" FontWeight="SemiBold" Foreground="#4ADE80" FontSize="12"/>
                    </Border>
                    <Border x:Name="LockStateBadge" Background="#1F2937" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,2,8,2">
                        <TextBlock x:Name="LockStateText" Text="🔓 Geçiş: Açık (ScrollLock / Ctrl+Alt+L)" Foreground="#9CA3AF" FontSize="11.5"/>
                    </Border>
                </WrapPanel>

                <!-- BU CİHAZIN 6 HANELİ KODU -->
                <Border Grid.Column="1" Background="#0D1117" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="7" Padding="10,4" Margin="8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="BU CİHAZIN KODU:" FontSize="10.5" FontWeight="SemiBold" Foreground="#93C5FD" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="PinCodeText" Text="--- ---" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="RegeneratePinBtn"
                                Click="RegeneratePinBtn_Click"
                                Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="6,2" Cursor="Hand"
                                ToolTip="Yeni 6 haneli güvenlik kodu üret"
                                Content="🔄"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="2"
                        x:Name="ToggleLockButton"
                        Click="ToggleLockButton_Click"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="12,6"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Content="🔒 Kilitle / Aç"/>
            </Grid>
        </Border>

        <!-- 2. ORTA ANA ÇALIŞMA ALANI: SOL (KOMPAKT CİHAZ & PIN LİSTESİ) + SAĞ (GENİŞ SEKMELİ KANVAS / CEP / LOG) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="325" MinWidth="270" MaxWidth="440"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SOL SÜTUN: BAĞLI CİHAZLAR & ÇİFT TARAFLI 6 HANELİ KOD PANELİ -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="📡 Cihazlar" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ScanDevicesBtn"
                                    Click="ScanDevicesBtn_Click"
                                    Background="#1F2937" Foreground="#38BDF8" BorderBrush="#30363D" Padding="7,3" Margin="0,0,5,0" Cursor="Hand"
                                    Content="🔍 Tara"/>
                            <Button x:Name="AddMultiSimBtn"
                                    Click="AddMultiSimBtn_Click"
                                    Background="#374151" Foreground="#F0F6FC" BorderThickness="0" Padding="7,3" Cursor="Hand"
                                    ToolTip="Test için sanal Android / Nobara Linux / Laptop cihazı ekler"
                                    Content="🧪 +Simüle Et"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- CİHAZ LİSTESİ (YATAY KAYDIRMA OLMADAN METİN SARMA İLE FERAH GÖRÜNÜM) -->
                    <ListBox x:Name="PeersListBox"
                             Grid.Row="1"
                             Background="#0D1117"
                             BorderBrush="#21262D"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="PeersListBox_SelectionChanged"
                             Margin="0,0,0,8"/>

                    <!-- ÇİFT TARAFLI 6 HANELİ PIN ONAY KUTUSU -->
                    <Border Grid.Row="2"
                            Background="#0D1117"
                            BorderBrush="#1E3A8A"
                            BorderThickness="1.5"
                            CornerRadius="7"
                            Padding="9"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="SelectedPeerTitleText"
                                       Text="🔐 Çift Taraflı 6 Haneli Kod Onayı"
                                       FontWeight="Bold" FontSize="12" Foreground="#60A5FA" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SelectedPeerStatusText"
                                       Text="Listeden bir cihaz seçip ekrandaki 6 haneli kodunu girin."
                                       FontSize="10.5" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,2,0,6"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RemotePinInputBox"
                                         Grid.Column="0"
                                         MaxLength="6"
                                         Background="#161B22"
                                         Foreground="#38BDF8"
                                         BorderBrush="#30363D"
                                         FontSize="14"
                                         FontWeight="Bold"
                                         Padding="6,4"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Karşı cihazın 6 haneli kodu"/>
                                <Button x:Name="VerifyRemotePinBtn"
                                        Grid.Column="1"
                                        Click="VerifyRemotePinBtn_Click"
                                        Background="#059669" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="10,5" Margin="5,0,0,0" Cursor="Hand"
                                        Content="✅ Doğrula"/>
                            </Grid>

                            <Button x:Name="SimConfirmOurPinBtn"
                                    Click="SimConfirmOurPinBtn_Click"
                                    Visibility="Collapsed"
                                    Background="#1D4ED8" Foreground="White" FontSize="11" BorderThickness="0" Padding="6,4" Margin="0,6,0,0" Cursor="Hand"
                                    Content="📲 [Sim] Karşı Cihazda Da Kodumu Onayla"/>
                        </StackPanel>
                    </Border>

                    <!-- MANUEL IP EKLEME -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ManualIpTextBox"
                                 Grid.Column="0"
                                 Background="#0D1117"
                                 Foreground="White"
                                 BorderBrush="#30363D"
                                 Padding="6,4"
                                 VerticalContentAlignment="Center"
                                 Text="192.168.1."
                                 ToolTip="Cihazın yerel IP adresi"/>
                        <Button x:Name="AddManualPeerBtn"
                                Grid.Column="1"
                                Click="AddManualPeerBtn_Click"
                                Background="#2563EB" Foreground="White" BorderThickness="0" Padding="9,4" Margin="5,0,0,0" Cursor="Hand"
                                Content="➕ IP Ekle"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="True"/>

            <!-- SAĞ ANA ALAN: SEKMELİ GENİŞ GÖRÜNÜM (1: 2D EKRAN KANVASI, 2: ORTAK CEP & PANO, 3: CANLI GÜNLÜK) -->
            <TabControl x:Name="MainWorkspaceTabs"
                        Grid.Column="2"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        Padding="10">

                <!-- SEKME 1: 2D EKRAN KONFİGÜRASYONU KANVASI -->
                <TabItem Header="🖥️ Ekran Konfigürasyonu (2D Harita)">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ÜST ARAÇ ÇUBUĞU: HIZLI HİZALAMA, ZOOM VE TEST -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Yakınlaştırma:" FontSize="11.5" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider x:Name="CanvasZoomSlider"
                                        Minimum="0.55" Maximum="1.35" Value="0.95"
                                        Width="110"
                                        VerticalAlignment="Center"
                                        ValueChanged="CanvasZoomSlider_ValueChanged"/>
                                <TextBlock x:Name="CanvasZoomPercentText" Text="95%" FontSize="11.5" Foreground="#38BDF8" VerticalAlignment="Center" Width="38" Margin="6,0,8,0"/>
                                <Button Content="🎯 Merkeze Sığdır"
                                        Click="FitCanvasViewBtn_Click"
                                        Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="8,3" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button x:Name="AutoArrangeScreensBtn"
                                        Click="AutoArrangeScreensBtn_Click"
                                        Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="8,3" Cursor="Hand"
                                        Content="📐 Kenarlara Dağıt"/>
                            </StackPanel>

                            <Button x:Name="TestSwitchBtn"
                                    Click="TestSwitchBtn_Click"
                                    HorizontalAlignment="Right"
                                    Background="#0284C7" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="12,4" Cursor="Hand"
                                    Content="🚀 Seçili Ekrana Şimdi Geç"/>
                        </DockPanel>

                        <!-- GENİŞ 2D EKRAN DİZİLİM KANVASI (FARE TEKERLEĞİ ZOOM DESTEKLİ) -->
                        <Border Grid.Row="1"
                                Background="#090D13"
                                BorderBrush="#21262D"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                ClipToBounds="True"
                                MouseWheel="CanvasContainer_MouseWheel">
                            <Canvas x:Name="DisplayArrangementCanvas"
                                    SizeChanged="DisplayArrangementCanvas_SizeChanged"
                                    Background="Transparent">
                                <Canvas.RenderTransform>
                                    <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="0.95" ScaleY="0.95"/>
                                </Canvas.RenderTransform>
                            </Canvas>
                        </Border>

                        <!-- ALT HIZLI KENAR BUTONLARI -->
                        <DockPanel Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock x:Name="CanvasSelectionInfoText"
                                       Text="Ekran kutularını sürükleyip merkez ekranın istediğiniz kenarına yapıştırın (Fare tekerleği ile yakınlaştırıp uzaklaştırabilirsiniz)."
                                       FontSize="11.5"
                                       Foreground="#38BDF8"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Seçili Cihazı Taşı:" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="⬅️ Sol" Click="QuickAssignLeft_Click" Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="8,3" Margin="2,0" Cursor="Hand"/>
                                <Button Content="⬆️ Üst" Click="QuickAssignTop_Click" Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="8,3" Margin="2,0" Cursor="Hand"/>
                                <Button Content="⬇️ Alt" Click="QuickAssignBottom_Click" Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="8,3" Margin="2,0" Cursor="Hand"/>
                                <Button Content="Sağ ➡️" Click="QuickAssignRight_Click" Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="8,3" Margin="2,0" Cursor="Hand"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- SEKME 2: ORTAK CEP (DROP SHELF) & EVRENSEL PANO -->
                <TabItem x:Name="DropShelfTabItem" Header="🧲 Ortak Cep (Drop Shelf) &amp; Pano">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="135"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="DropZoneBorder"
                                Grid.Row="0"
                                Background="#0D1117"
                                BorderBrush="#38BDF8"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Margin="0,0,0,12"
                                AllowDrop="True"
                                Drop="Window_Drop"
                                DragOver="Window_DragOver">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📂 Dosya, Fotoğraf veya Metni Pencerenin Herhangi Bir Yerine Sürükleyip Bırakın"
                                           FontWeight="Bold" FontSize="14" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                <TextBlock Text="Seçili cihaza veya çift taraflı onaylanmış tüm cihazlara yüksek hızla gönderilir"
                                           FontSize="11.5" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,4,0,10"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="PickFileToSendBtn"
                                            Click="PickFileToSendBtn_Click"
                                            Background="#0284C7" Foreground="White" BorderThickness="0" Padding="14,6" Margin="0,0,8,0" Cursor="Hand"
                                            Content="📤 Dosya Seç ve Gönder"/>
                                    <Button x:Name="OpenShelfFolderBtn"
                                            Click="OpenShelfFolderBtn_Click"
                                            Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="14,6" Cursor="Hand"
                                            Content="📁 İndirilen Cep Klasörünü Aç"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="📦 Ortak Cepteki Paylaşılan Eşyalar (Çift tıklayarak klasörde gösterin):"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,6"/>

                        <ListBox x:Name="ShelfItemsListBox"
                                 Grid.Row="2"
                                 Background="#0D1117"
                                 BorderBrush="#21262D"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 MouseDoubleClick="ShelfItemsListBox_MouseDoubleClick"
                                 Margin="0,0,0,10"/>

                        <Border Grid.Row="3"
                                Background="#0D1117"
                                BorderBrush="#21262D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <DockPanel>
                                <CheckBox x:Name="AutoClipboardCheckBox"
                                          IsChecked="True"
                                          Checked="AutoClipboardCheckBox_Changed"
                                          Unchecked="AutoClipboardCheckBox_Changed"
                                          Foreground="White"
                                          VerticalAlignment="Center"
                                          Content="📋 Evrensel Pano Otomatik Senkronizasyon (Metin &amp; Ekran Görüntüsü)"/>
                                <Button x:Name="PushClipboardNowBtn"
                                        Click="PushClipboardNowBtn_Click"
                                        HorizontalAlignment="Right"
                                        Background="#1F2937" Foreground="#38BDF8" BorderBrush="#30363D" Padding="12,5" Cursor="Hand"
                                        Content="⚡ Panoyu Şimdi Tüm Cihazlara Gönder"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- SEKME 3: CANLI TELEMETRİ & AĞ GÜNLÜĞÜ -->
                <TabItem Header="📡 Canlı Günlük (Log)">
                    <Grid Margin="4">
                        <ListBox x:Name="TelemetryLogListBox"
                                 Background="#0D1117"
                                 BorderBrush="#21262D"
                                 Foreground="#A7F3D0"
                                 FontFamily="Consolas"
                                 FontSize="11.5"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 3. ALT TEK SATIRLIK DURUM & SON BİLDİRİM ÇUBUĞU -->
        <Border Grid.Row="2"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,5"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LatestLogTickerText"
                           Grid.Column="0"
                           Text="Hazır."
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#A7F3D0"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="LocalNetworkInfoText"
                           Grid.Column="1"
                           Text="IP: Yükleniyor..."
                           FontSize="11"
                           Foreground="#8B949E"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
